# Copy to .env. Keep secrets out of source control.
LUNGLENS_DEVICE=cpu
# Comma-separated frontend origins, once the frontend is available.
LUNGLENS_ALLOWED_ORIGINS=

# disabled | local | remote. Classifier works with MedGemma disabled.
LUNGLENS_MEDGEMMA_MODE=disabled
LUNGLENS_MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
# For multimodal 27B use google/medgemma-27b-it with a suitable GPU endpoint.
LUNGLENS_MEDGEMMA_REVISION=main
LUNGLENS_MEDGEMMA_ALLOW_CPU=false
# OpenAI-compatible base URL ending in /v1, with no trailing slash.
LUNGLENS_MEDGEMMA_URL=
LUNGLENS_MEDGEMMA_API_KEY=
# For local downloads authenticate using hf auth login; do not add tokens here.
